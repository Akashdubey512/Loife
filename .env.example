# ========================================================
# reServe AI - Environment Configuration
# Enterprise AI-Powered Food Waste Reduction & Redistribution Platform
# ========================================================

# General Platform Settings
ENVIRONMENT=development
PROJECT_NAME="reServe AI Platform"
API_V1_STR="/api/v1"
# Generate a secure 64-char hex key via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-with-a-secure-randomly-generated-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Authentication Endpoint Rate Limiting
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Backend & Database
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# PostgreSQL container credentials (required when deploying via docker-compose)
POSTGRES_USER=reserve_user
POSTGRES_PASSWORD=replace-with-a-secure-database-password
POSTGRES_DB=reserve_ai_db
DATABASE_URL=postgresql://reserve_user:replace-with-a-secure-database-password@localhost:5432/reserve_ai_db
# Fallback SQLite for local testing without local PostgreSQL:
SQLITE_FALLBACK_URL=sqlite:///./reserve_ai.db

# Redis & Caching / Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MQTT / IoT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=reserveai/kitchens/

# Machine Learning & Computer Vision Services
ML_SERVICE_URL=http://localhost:8001
MLFLOW_TRACKING_URI=http://localhost:5000
CV_MODEL_PATH=./cv/weights/freshness_efficientnet.onnx
DEMAND_MODEL_PATH=./ml/weights/demand_lgbm.pkl
WASTE_MODEL_PATH=./ml/weights/waste_xgb.pkl
MAINTENANCE_MODEL_PATH=./ml/weights/maintenance_catboost.pkl

# Logistics & Routing
OSRM_ROUTING_URL=https://router.project-osrm.org
MAX_DELIVERY_RADIUS_KM=25.0

# Sustainability Engine (Poore & Nemecek Baseline Factor Path)
EMISSIONS_FACTOR_DATA_PATH=./ml/data/sustainability_factors.json

# Frontend & CORS Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
# Comma-separated list of trusted frontend origins. Wildcards ('*') are strictly prohibited in production.
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
